#!/bin/sh /etc/rc.common
# myTV SUPER 开机自动切台 —— 服务控制脚本
#
# 用法：
#   /etc/init.d/mytvsuper-autostart start|stop|restart|status|enable|disable
# 日志：
#   logread -e mytvsuper      （syslog）
#   tail -f /var/lib/mytvsuper-autostart/watch.log

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/mytvsuper-autostart/bin/watch.sh
VAR_DIR=/var/lib/mytvsuper-autostart
LOG_FILE=$VAR_DIR/info.log

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE" 2>/dev/null || true
    logger -t mytvsuper "$1" 2>/dev/null || true
}

start_service() {
    mkdir -p "$VAR_DIR" 2>/dev/null

    # 确保解释器与二进制可执行位（zip/tar 打包可能丢失）
    [ -x "$PROG" ] || chmod +x "$PROG" 2>/dev/null

    ADB_DIR=/usr/libexec/mytvsuper-autostart/adb
    for f in "$ADB_DIR"/adb-*; do
        [ -f "$f" ] && [ ! -x "$f" ] && chmod +x "$f" 2>/dev/null
    done

    procd_open_instance
    procd_set_param command /bin/sh "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param env HOME="$VAR_DIR/home"
    procd_close_instance

    log_msg "service starting"
}

stop_service() {
    log_msg "service stopping"
}

service_triggers() {
    procd_add_reload_trigger "mytvsuper-autostart"
}

reload_service() {
    stop
    start
}
